# Copy this file to an untracked environment file before producing an App Store archive.
# Never commit real signing credentials, API keys, or certificate material.

DEVELOPMENT_TEAM=YOUR10CHARTEAMID
PINGO_API_BASE_URL=https://api.example.com/v1
PINGO_MESSAGE_BASE_URL=https://example.com/match
MARKETING_VERSION=1.0.0
CURRENT_PROJECT_VERSION=1

# Optional when xcodebuild should authenticate with App Store Connect for automatic provisioning.
APP_STORE_CONNECT_KEY_ID=YOURKEYID
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_CONNECT_KEY_PATH=/absolute/path/to/AuthKey_YOURKEYID.p8
